<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>msfs-hud-sender</AssemblyName>
  </PropertyGroup>

  <!-- The sender talks to MSFS with its own SimConnect client (SimConnect/), so
       the default build needs neither the MSFS SDK nor Microsoft's DLLs.
       -p:UseSdkSimConnect=true additionally builds the old client on Microsoft's
       managed SimConnect API (needs MSFS_SDK), selectable with the sender option sdk-simconnect. -->
  <PropertyGroup Condition="'$(UseSdkSimConnect)' == 'true'">
    <SimConnectManagedDll>$(MSFS_SDK)\SimConnect SDK\lib\managed\Microsoft.FlightSimulator.SimConnect.dll</SimConnectManagedDll>
    <SimConnectNativeDll>$(MSFS_SDK)\SimConnect SDK\lib\SimConnect.dll</SimConnectNativeDll>
    <HasSimConnect Condition="Exists('$(SimConnectManagedDll)')">true</HasSimConnect>
  </PropertyGroup>

  <PropertyGroup Condition="'$(HasSimConnect)' == 'true'">
    <DefineConstants>$(DefineConstants);SIMCONNECT</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MsfsHudSender.Tests" />
  </ItemGroup>

  <ItemGroup Condition="'$(HasSimConnect)' == 'true'">
    <Reference Include="Microsoft.FlightSimulator.SimConnect">
      <HintPath>$(SimConnectManagedDll)</HintPath>
    </Reference>
    <!-- The managed wrapper loads the native client library from next to the exe -->
    <None Include="$(SimConnectNativeDll)" Link="SimConnect.dll" CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('$(SimConnectNativeDll)')" />
  </ItemGroup>

  <Target Name="FailWithoutSdk" BeforeTargets="Build"
          Condition="'$(UseSdkSimConnect)' == 'true' And '$(HasSimConnect)' != 'true'">
    <Error Text="UseSdkSimConnect=true but the MSFS SDK was not found (MSFS_SDK='$(MSFS_SDK)')." />
  </Target>

</Project>
